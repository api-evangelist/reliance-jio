              },
              {
                "name": "Authorization",
                "value": "<Authentication_token_signed_using_secret_or_private_key>"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "This API deletes a scheduled webinar using the meetingId returned when the webinar was created"
        },
        {
          "info": {
            "name": "Webinar - Download attendance/ Registration report",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://jioevents.com/api/platform/v1/webinar/:meetingId/download",
            "headers": [
              {
                "name": "Authorization",
                "value": "<Authentication_token_signed_using_secret_or_private_key>"
              }
            ],
            "params": [
              {
                "name": "meetingId",
                "value": "sm-ead69d8e-8c30-42f1-9798-8acfa5dd1277",
                "type": "path",
                "description": "The meeting ID for which to download attendance/ registration data"
              },
              {
                "name": "registered",
                "value": "true",
                "type": "query",
                "description": "When set to true, generates registration report instead of attendance data"
              }
            ]
          },
          "docs": "This API generates and provides a download link for webinar attendance/ registration data"
        }
