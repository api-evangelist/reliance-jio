        {
          "info": {
            "name": "Meeting Invite - Create a meeting invite",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://jioevents.com/api/platform/v1/meetingInvite",
            "headers": [
              {
                "name": "Content-Type",
                "value": "application/json"
              },
              {
                "name": "Authorization",
                "value": "<Authentication_token_signed_using_secret_or_private_key>"
              },
              {
                "name": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "This API creates a meeting invite for a participant to join a scheduled webinar or meeting"
        },
        {
          "info": {
            "name": "Sessions - Delete a session",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://jioevents.com/api/platform/v1/sessions/:meetingId/:sessionId",
            "headers": [
              {
                "name": "Authorization",
                "value": "<Authentication_token_signed_using_secret_or_private_key>"
              },
              {
                "name": "Content-Type",
                "value": "application/json"
              }
            ],
            "params": [
              {
                "name": "meetingId",
                "value": "sm-ead69d8e-8c30-42f1-9798-8acfa5dd1277",
                "type": "path",
                "description": "The meeting ID for which to delete the session"
              },
              {
                "name": "sessionId",
                "value": "se-77a4ef5e-0e86-4217-9f5b-08d766a48aef",
                "type": "path",
                "description": "The ID of the session to delete"
              }
            ]
          },
          "docs": "This API deletes a specific session for a meeting"
        },
