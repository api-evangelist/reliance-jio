        {
          "info": {
            "name": "Scheduled Webinar - Fetch a scheduled webinar",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://jioevents.com/api/platform/v1/schedule/webinar",
            "headers": [
              {
                "name": "Content-Type",
                "value": "application/json"
              },
              {
                "name": "Authorization",
                "value": "<Authentication_token_signed_using_secret_or_private_key>"
              }
            ],
            "params": [
              {
                "name": "meetingId",
                "value": "sm-123456789",
                "type": "query",
                "description": "The meeting Id of the scheduled webinar"
              },
              {
                "name": "jiomeetId",
                "value": "1234567890",
                "type": "query",
                "description": "The 10 digit unique jiomeetId of the webinar"
              },
              {
                "name": "fromDate",
                "value": "2024-03-01",
                "type": "query",
                "description": "Start of the time range. To be used in combination with toDate"
              },
              {
                "name": "endDate",
                "value": "2024-03-31",
                "type": "query",
                "description": "End of the time range. To be used in combination with fromDate"
              }
            ]
          },
          "docs": "This API fetches scheduled webinar/s using the meetingId, jiomeetId or the time range"
        },
        {
          "info": {
            "name": "Scheduled Webinar - Create a scheduled webinar",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://jioevents.com/api/platform/v1/schedule/webinar",
            "headers": [
              {
                "name": "Content-Type",
                "value": "application/json"
              },
              {
                "name": "Authorization",
                "value": "<Authentication_token_signed_using_secret_or_private_key>"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "This API creates a scheduled webinar. Webinar validity is maintained until the host establishes the start time and end time parameters."
        },
        {
          "info": {
            "name": "Scheduled Webinar - Update a scheduled webinar",
            "type": "http"
