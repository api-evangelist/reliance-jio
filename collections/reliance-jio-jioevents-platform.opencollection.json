                "value": "application/json"
              },
              {
                "name": "Authorization",
                "value": "<Authentication_token_signed_using_secret_or_private_key>"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "This API updates a scheduled webinar using the meetingId returned when the webinar was created"
        },
        {
          "info": {
            "name": "Scheduled Webinar - Delete a scheduled webinar",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://jioevents.com/api/platform/v1/schedule/webinar",
            "headers": [
              {
                "name": "Content-Type",
