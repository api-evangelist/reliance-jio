        {
          "info": {
            "name": "Meeting Invite - Get meeting invites",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://jioevents.com/api/platform/v1/meetingInvite/:meetingId",
            "headers": [
              {
                "name": "Authorization",
                "value": "<Authentication_token_signed_using_secret_or_private_key>"
              }
            ],
            "params": [
              {
                "name": "meetingId",
                "value": "sm-ead69d8e-8c30-42f1-9798-8acfa5dd1277",
                "type": "path",
                "description": "The meeting ID for which to retrieve invites"
              },
              {
                "name": "offset",
                "value": "0",
                "type": "query",
                "description": "Number of records to skip for pagination"
              },
              {
                "name": "limit",
                "value": "10",
                "type": "query",
                "description": "Maximum number of records to return"
              },
              {
                "name": "keyword",
                "value": "",
                "type": "query",
                "description": "Search keyword to filter invites"
              }
            ]
          },
          "docs": "This API retrieves meeting invites for a specific meeting with pagination and filtering capabilities"
        },
